{
  "name": "buergergeldrechner-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "bun run --filter '*' --if-present build",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "lint": "bun run --filter '*' --if-present lint",
    "test": "bun run test:unit",
    "test:unit": "bun run --filter '@buergergeldrechner/web' test:unit && bun run --filter 'calculation' test",
    "test:e2e": "bun run --filter '@buergergeldrechner/web' test:e2e",
    "check": "bun scripts/check.ts"
  },
  "keywords": [],
  "author": "",
